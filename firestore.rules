rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.email == '207edx@gmail.com'; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function onlyChanged(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if admin() || (owner(uid) && request.resource.data.role == 'student');
      allow update: if admin() || (owner(uid) && onlyChanged(['displayName','photoURL','theme','watched']));
      allow delete: if admin();
    }
    match /folders/{id} {
      allow read: if signedIn();
      allow write: if admin();
    }
    match /materials/{id} {
      allow read: if signedIn();
      allow write: if admin();
      match /doubts/{doubtId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
        allow update: if admin();
        allow delete: if admin() || owner(resource.data.studentId);
      }
    }
    match /doubts/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if admin() || onlyChanged(['upvotes']);
      allow delete: if admin() || owner(resource.data.studentId);
    }
    match /votes/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && id == request.auth.uid + '_' + request.resource.data.targetId;
      allow update, delete: if false;
    }
    match /live_sessions/{sid} {
      allow read: if signedIn();
      allow write: if admin();
      match /chats/{id} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
        allow update: if false;
        allow delete: if admin() || owner(resource.data.senderId);
      }
      match /doubts/{id} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
        allow update: if admin() || onlyChanged(['upvotes']);
        allow delete: if admin() || owner(resource.data.studentId);
      }
      match /polls/{id} {
        allow read: if signedIn();
        allow create, delete, update: if admin();
      }
      match /attendance/{id} {
        allow read: if signedIn();
        allow write: if admin();
      }
    }
    match /poll_templates/{id} {
      allow read: if signedIn();
      allow write: if admin();
    }
    match /poll_history/{id} {
      allow read: if signedIn();
      allow write: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}